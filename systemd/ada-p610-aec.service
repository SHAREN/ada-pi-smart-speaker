[Unit]
Description=ADA Pi P610 PipeWire echo cancellation
After=pipewire-pulse.service wireplumber.service ada-tv-aec.service
Wants=ada-tv-aec.service
BindsTo=pipewire-pulse.service
PartOf=pipewire-pulse.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=XDG_RUNTIME_DIR=%t
Environment=ADA_TV_SUPPRESSION_ENABLED=false
ExecStart=%h/ada-pi/scripts/p610-aec.sh start
ExecStop=%h/ada-pi/scripts/p610-aec.sh stop

[Install]
WantedBy=default.target
